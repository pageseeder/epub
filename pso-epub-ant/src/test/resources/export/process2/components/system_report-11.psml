<?xml version="1.0" encoding="UTF-8"?><document id="166996" schemaversion="1.4" date="2026-09-09T15:02:39+10:00" version="current" level="processed" position="1" publicationid="ebl1-syst-port-3u4v"><documentinfo><uri id="166996" external="false" mediatype="application/vnd.pageseeder.psml+xml" created="2026-09-09T15:02:39+10:00" modified="2026-09-09T15:02:39+10:00" scheme="http" host="pr.localhost" port="80" path="/ps/epub/local1/documents/system_report/components/system_report-11.psml" decodedpath="/ps/epub/local1/documents/system_report/components/system_report-11.psml" title="Usability"><displaytitle>Usability</displaytitle></uri><reversexrefs><reversexref uriid="167013" href="../system_report.psml" frag="content" urititle="System Report" mediatype="application/vnd.pageseeder.psml+xml" documenttype="references" id="719625" title="" type="none" forwardtype="embed" forwardtitle="Usability" forwarddisplay="document" forwardfrag="default" level="1"/></reversexrefs></documentinfo><fragmentinfo structure-modified="2019-09-10T11:43:43+10:00"><locator fragment="166996-1-1" modified="2018-06-08T16:48:14+10:00"/></fragmentinfo><metadata/><section id="166996-title"><fragment id="166996-title"><heading level="1" numbered="true" prefix="2.4" id="166996-1-title-1">Usability</heading></fragment></section><section id="166996-body"><fragment id="166996-1-1"><para>This section should include all of those requirements that affect usability. Examples:</para><list><item>Specify the required training time for a normal users and power users to become productive at particular operations.</item><item>Specify measurable task times for typical tasks, or</item><item>Base usability requirements of the new system on other systems that the users know and like.</item><item>Specify requirements to conform to common usability standards: e.g., IBM's CUA standards, or the GUI standards published by Microsoft for Windows 95.</item></list></fragment><fragment id="166996-1-2"><heading level="2" numbered="true" prefix="2.4.1" id="166996-1-1-2-1">Usability requirement one</heading><para>The requirement description. </para></fragment></section></document>