<?xml version="1.0" encoding="UTF-8"?><document id="166976" schemaversion="1.4" date="2026-09-09T15:02:39+10:00" version="current" level="processed" position="1" publicationid="ebl1-syst-port-3u4v"><documentinfo><uri id="166976" external="false" mediatype="application/vnd.pageseeder.psml+xml" created="2026-09-09T15:02:39+10:00" modified="2026-09-09T15:02:39+10:00" scheme="http" host="pr.localhost" port="80" path="/ps/epub/local1/documents/system_report/components/system_report-10.psml" decodedpath="/ps/epub/local1/documents/system_report/components/system_report-10.psml" title="Functionality"><displaytitle>Functionality</displaytitle></uri><reversexrefs><reversexref uriid="167004" href="../_local/documents/system_report_2/components/requirements.psml" frag="2" urititle="Requirements" mediatype="application/vnd.pageseeder.psml+xml" documenttype="references" id="719597" title="" type="none" forwardtype="embed" forwarddisplay="document" forwardfrag="default"/><reversexref uriid="167013" href="../system_report.psml" frag="content" urititle="System Report" mediatype="application/vnd.pageseeder.psml+xml" documenttype="references" id="719624" title="" type="none" forwardtype="embed" forwardtitle="Functionality" forwarddisplay="document" forwardfrag="default" level="1"/></reversexrefs></documentinfo><fragmentinfo structure-modified="2019-09-10T11:43:43+10:00"><locator id="245892" fragment="166976-10" modified="2019-09-10T12:16:03+10:00"/><locator id="245890" fragment="166976-9" modified="2019-09-10T12:16:03+10:00"/><locator id="245879" fragment="166976-14" modified="2021-09-13T17:14:46+10:00"/><locator id="245911" fragment="166976-2" modified="2018-06-12T09:26:54+10:00"><reversexrefs><reversexref uriid="167017" href="system_report-12.psml" frag="1-2" urititle="Reliability" mediatype="application/vnd.pageseeder.psml+xml" id="719649" title="" config="para" type="none" forwardtype="none" forwardtitle="2.3.1.(a)(i)" forwarddisplay="template" forwardfrag="2"/></reversexrefs></locator><locator id="245883" fragment="166976-1-1" modified="2021-09-13T17:14:46+10:00"/><locator id="245898" fragment="166976-1-2" modified="2018-05-22T15:39:25+10:00"><reversexrefs><reversexref uriid="167000" href="system_report-09.psml" frag="1-1" urititle="Business Case" mediatype="application/vnd.pageseeder.psml+xml" id="719590" title="" config="numbered-heading" type="none" forwardtype="none" forwardtitle="2.3.1 Account" forwarddisplay="template" forwardfrag="1-2"/><reversexref uriid="167017" href="system_report-12.psml" frag="1" urititle="Reliability" mediatype="application/vnd.pageseeder.psml+xml" id="719647" title="" config="numbered-heading" type="none" forwardtype="none" forwardtitle="2.3.1 Account" forwarddisplay="template" forwardfrag="1-2"/></reversexrefs></locator><locator id="245882" fragment="166976-3" modified="2018-05-16T14:56:31+10:00"><reversexrefs><reversexref uriid="166976" href="system_report-10.psml" frag="5" urititle="Functionality" mediatype="application/vnd.pageseeder.psml+xml" id="719547" title="" config="internal-para" type="none" forwardtype="none" forwardtitle="(ii)" forwarddisplay="template" forwardfrag="3"/></reversexrefs></locator><locator id="245897" fragment="166976-1" modified="2018-05-16T14:55:51+10:00"><reversexrefs><reversexref uriid="167000" href="system_report-09.psml" frag="1-1" urititle="Business Case" mediatype="application/vnd.pageseeder.psml+xml" id="719589" title="" config="para" type="none" forwardtype="none" forwardtitle="2.3.1.(a)" forwarddisplay="template" forwardfrag="1"/></reversexrefs></locator><locator id="245881" fragment="166976-5" modified="2019-09-10T12:16:03+10:00"/><locator id="245887" fragment="166976-8" modified="2019-09-10T12:16:03+10:00"/><locator fragment="166976-11" modified="2021-09-13T17:14:47+10:00"/><locator fragment="166976-12" modified="2018-05-23T13:01:27+10:00"/><locator fragment="166976-13" modified="2018-06-06T09:50:23+10:00"/><locator fragment="166976-4" modified="2018-05-16T14:56:45+10:00"/><locator fragment="166976-6" modified="2018-05-16T16:34:28+10:00"/><locator fragment="166976-7" modified="2019-09-10T12:17:18+10:00"/></fragmentinfo><metadata/><section id="166976-title"><fragment id="166976-title"><heading level="1" numbered="true" prefix="2.3" id="166976-1-title-1">Functionality</heading></fragment></section><section id="166976-body"><fragment id="166976-1-1"><para>This section describes the functional requirements of the system for those requirements which are expressed in the natural language style. For many applications, this may constitute the bulk of the SR Package and thought should be given to the organisation of this section. This section is typically organised by feature, but alternative organisation methods, for example organisation by user, or organisation by subsystem may also be appropriate. Functional requirements may include: feature sets, capabilities and security<xref id="719548" title="f{fragment}" frag="3" reversefrag="1-1" reversetitle="" reverselink="true" reversetype="none" display="template" config="footnote" type="alternate" uriid="166991" href="footnotes.psml" urititle="Footnotes" mediatype="application/vnd.pageseeder.psml+xml" documenttype="footnotes"><locator id="245884" fragment="166991-3" modified="2018-05-16T13:30:42+10:00"><reversexrefs><reversexref uriid="166976" href="system_report-10.psml" frag="1-1" urititle="Functionality" mediatype="application/vnd.pageseeder.psml+xml" id="719548" title="" config="footnote" type="none" forwardtype="alternate" forwardtitle="f{fragment}" forwarddisplay="template" forwardfrag="3"/></reversexrefs></locator><fragment id="166991-3"><para>Where application development tools (requirements tools, modelling tools, etc) are employed to capture the functionality, this section document will refer to the availability of that data and indicate the location and name of the tool which is used to capture the data.</para></fragment></xref>.</para><para>Object-oriented design <xref id="719549" title="({heading})" frag="2" reversefrag="1-1" reversetitle="" reverselink="true" reversetype="none" display="template" config="citation" type="none" uriid="167034" href="bibliography.psml" urititle="Bibliography" mediatype="application/vnd.pageseeder.psml+xml" documenttype="bibliography">(Wikipedia)</xref> should be used where applicable referencing relevant use cases <xref id="719550" title="({heading})" frag="1" reversefrag="1-1" reversetitle="" reverselink="true" reversetype="none" display="template" config="citation" type="none" uriid="167034" href="bibliography.psml" urititle="Bibliography" mediatype="application/vnd.pageseeder.psml+xml" documenttype="bibliography">(Jacobson, 1992)</xref><inline label="pages">20-30</inline>.<br/>
 </para><table width="500px">
<col/>
<col/>
<row part="header"><cell>Feature</cell><cell>Importance</cell></row>
<row><cell>Account</cell><cell>High</cell></row><row><cell>Equations</cell><cell>Medium</cell></row></table><block label="table-caption">
<para indent="1" numbered="true" prefix="Table 2-1">Feature summary.</para>
</block><para>Each section under functionality should be numbered in the format x.x.x for easy reference.</para></fragment><fragment id="166976-1-2"><heading level="2" numbered="true" prefix="2.3.1" id="166976-1-1-2-1">Account</heading></fragment><fragment id="166976-1"><para indent="1" numbered="true" prefix="(a)">Should allow creation of user accounts, including:</para></fragment><fragment id="166976-2"><para indent="2" numbered="true" prefix="(i)">A username allowing alpha/numeric characters only.</para></fragment><fragment id="166976-3"><para indent="2" numbered="true" prefix="(ii)">An email address.</para></fragment><fragment id="166976-4"><para indent="2" numbered="true" prefix="(iii)">A password.</para></fragment><fragment id="166976-5"><para indent="2" numbered="true" prefix="(iv)">Email address in <xref id="719547" title="{prefix}" frag="3" reversefrag="5" reversetitle="" reverselink="true" reversetype="none" display="template" config="internal-para" type="none" uriid="166976" href="#166976-3" urititle="Functionality" mediatype="application/vnd.pageseeder.psml+xml">(ii)</xref> should be verified by sending an email with a confirmation link.</para></fragment><fragment id="166976-6"><heading level="2" numbered="true" prefix="2.3.2" id="166976-1-6-1">Equations</heading></fragment><fragment id="166976-7"><para indent="1" numbered="true" prefix="(a)">Equations using inline labels should be supported, for example <xref frag="media" type="math" config="mathml"><media-fragment id="media" mediatype="application/mathml+xml"><math xmlns="http://www.w3.org/1998/Math/MathML">
  <mstyle displaystyle="true">
    <mi>a</mi>
    <mo>=</mo>
    <msup>
      <mi>b</mi>
      <mn>2</mn>
    </msup>
    <mo>+</mo>
    <mi>c</mi>
  </mstyle>
</math>
</media-fragment></xref>.</para></fragment><fragment id="166976-8"><para indent="1" numbered="true" prefix="(b)">Equations from an AsciiMath library, for example <xref id="719551" frag="1" reversefrag="8" reversetitle="" reverselink="true" reversetype="none" display="document" config="asciimath" type="math" uriid="167030" href="../_local/documents/asciimath/asciimath-001.psml" urititle="Exponential 1" urilabels="simple,exponential" mediatype="application/vnd.pageseeder.psml+xml" documenttype="asciimath"><locator id="245888" fragment="167030-1" modified="2019-09-10T12:18:08+10:00"/><media-fragment id="167030-1" mediatype="application/mathml+xml"><math xmlns="http://www.w3.org/1998/Math/MathML">
  <mstyle displaystyle="true">
    <mi>y</mi>
    <mo>=</mo>
    <msup>
      <mi>x</mi>
      <mn>2</mn>
    </msup>
  </mstyle>
</math>
</media-fragment></xref> or <xref id="719552" frag="1" reversefrag="8" reversetitle="" reverselink="true" reversetype="none" display="document" config="asciimath" type="math" uriid="167024" href="../_local/documents/asciimath/asciimath-004.psml" urititle="Exponential 4" urilabels="complex,exponential" mediatype="application/vnd.pageseeder.psml+xml" documenttype="asciimath"><locator id="245889" fragment="167024-1" modified="2019-09-10T12:18:39+10:00"/><media-fragment id="167024-1" mediatype="application/mathml+xml"><math xmlns="http://www.w3.org/1998/Math/MathML">
  <mstyle displaystyle="true">
    <mi>y</mi>
    <mo>=</mo>
    <msup>
      <mi>x</mi>
      <mn>2</mn>
    </msup>
    <mo>+</mo>
    <mi>z</mi>
  </mstyle>
</math>
</media-fragment></xref>.</para></fragment><fragment id="166976-10"><para indent="1" numbered="true" prefix="(c)">Equations from a MathML <xref id="719554" title="({heading})" frag="3" reversefrag="10" reversetitle="" reverselink="true" reversetype="none" display="template" config="citation" type="none" uriid="167034" href="bibliography.psml" urititle="Bibliography" mediatype="application/vnd.pageseeder.psml+xml" documenttype="bibliography">(W3C)</xref> library, for example <xref id="719555" frag="1" reversefrag="10" reversetitle="" reverselink="true" reversetype="none" display="document" config="mathml" type="math" uriid="167011" href="../_local/documents/mathml/mathml-002.psml" urititle="Exponential 2" mediatype="application/vnd.pageseeder.psml+xml" documenttype="mathml"><locator id="245894" fragment="167011-1" modified="2018-09-07T11:37:15+10:00"/><media-fragment id="167011-1" mediatype="application/mathml+xml"><math xmlns="http://www.w3.org/1998/Math/MathML"><mi>y</mi><mo>=</mo><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mn>1</mn></math></media-fragment></xref>.</para></fragment><fragment id="166976-9"><para indent="1" numbered="true" prefix="(d)">Search equations from a library <xref id="719553" frag="1" reversefrag="9" reversetitle="" reverselink="true" reversetype="none" display="document" config="mathml" type="math" uriid="167020" href="../_local/documents/mathml/mathml-001.psml" urititle="Exponential 1" mediatype="application/vnd.pageseeder.psml+xml" documenttype="mathml"><locator id="245891" fragment="167020-1" modified="2019-10-15T17:39:18+11:00"/><media-fragment id="167020-1" mediatype="application/mathml+xml"><math xmlns="http://www.w3.org/1998/Math/MathML"><mi>y</mi><mo>=</mo><mfrac><mrow><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mn>3</mn></mrow><mn>2</mn></mfrac></math></media-fragment></xref>.</para></fragment><fragment id="166976-11"><table width="500px">
<col part="header"/>
<col/>
<col/>
<row part="header"><cell/><cell>Inline label</cell><cell>Inline transclude</cell></row>
<row><hcell>AsciiMath</hcell><cell>yes</cell><cell>yes</cell></row><row><hcell>MathML</hcell><cell>no</cell><cell>yes</cell></row></table><block label="table-caption">
<para indent="1" numbered="true" prefix="Table 2-2">Math support.</para>
</block></fragment><fragment id="166976-14"><para><image src="diagram3.jpg" uriid="167023" width="200" height="332"/></para><block label="figure-caption">
<para indent="1" numbered="true" prefix="Fig 2-A">Extra components</para>
</block></fragment></section></document>