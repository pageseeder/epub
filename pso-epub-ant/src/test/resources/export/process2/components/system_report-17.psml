<?xml version="1.0" encoding="UTF-8"?><document id="166998" schemaversion="1.4" date="2026-09-09T15:02:39+10:00" version="current" level="processed" position="1" publicationid="ebl1-syst-port-3u4v"><documentinfo><uri id="166998" external="false" mediatype="application/vnd.pageseeder.psml+xml" created="2026-09-09T15:02:39+10:00" modified="2026-09-09T15:02:39+10:00" scheme="http" host="pr.localhost" port="80" path="/ps/epub/local1/documents/system_report/components/system_report-17.psml" decodedpath="/ps/epub/local1/documents/system_report/components/system_report-17.psml" title="Design Constraints"><displaytitle>Design Constraints</displaytitle></uri><reversexrefs><reversexref uriid="167013" href="../system_report.psml" frag="content" urititle="System Report" mediatype="application/vnd.pageseeder.psml+xml" documenttype="references" id="719631" title="" type="none" forwardtype="embed" forwardtitle="Design Constraints" forwarddisplay="document" forwardfrag="default" level="1"/></reversexrefs></documentinfo><fragmentinfo structure-modified="2019-09-10T11:43:43+10:00"/><metadata/><section id="166998-title"><fragment id="166998-title"><heading level="1" numbered="true" prefix="2.10" id="166998-1-title-1">Design Constraints</heading></fragment></section><section id="166998-body"><fragment id="166998-1-1"><para>This section should indicate any design constraints on the system being built. Design constraints represent design decisions that have been mandated and must be adhered to. Examples include software languages, software process requirements, prescribed use of developmental tools, architectural and design constraints, purchased components, class libraries, etc.</para></fragment><fragment id="166998-1-2"><heading level="2" numbered="true" prefix="2.10.1" id="166998-1-1-2-1"> Design constraint one</heading><para>The constraint description. </para></fragment></section></document>