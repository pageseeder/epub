<?xml version="1.0" encoding="UTF-8"?><document id="166991" schemaversion="1.4" type="footnotes" date="2026-09-09T15:02:39+10:00" version="current" level="processed" position="1" publicationid="ebl1-syst-port-3u4v"><documentinfo><uri id="166991" external="false" mediatype="application/vnd.pageseeder.psml+xml" documenttype="footnotes" created="2026-09-09T15:02:39+10:00" modified="2026-09-09T15:02:39+10:00" scheme="http" host="pr.localhost" port="80" path="/ps/epub/local1/documents/system_report/components/footnotes.psml" decodedpath="/ps/epub/local1/documents/system_report/components/footnotes.psml" title="Footnotes"><displaytitle>Footnotes</displaytitle></uri></documentinfo><fragmentinfo structure-modified="2020-04-03T17:31:23+11:00"><locator id="245909" fragment="166991-4" modified="2018-06-26T14:53:34+10:00"><reversexrefs><reversexref uriid="167017" href="system_report-12.psml" frag="1-1" urititle="Reliability" mediatype="application/vnd.pageseeder.psml+xml" id="719648" title="" config="footnote" type="none" forwardtype="alternate" forwardtitle="f{fragment}" forwarddisplay="template" forwardfrag="4"/></reversexrefs></locator><locator id="245884" fragment="166991-3" modified="2018-05-16T13:30:42+10:00"><reversexrefs><reversexref uriid="166976" href="system_report-10.psml" frag="1-1" urititle="Functionality" mediatype="application/vnd.pageseeder.psml+xml" id="719548" title="" config="footnote" type="none" forwardtype="alternate" forwardtitle="f{fragment}" forwarddisplay="template" forwardfrag="3"/></reversexrefs></locator><locator fragment="166991-2" modified="2020-04-03T17:31:23+11:00"/></fragmentinfo><metadata/><section id="166991-title" lockstructure="true"><fragment id="166991-1">
      <heading level="1" id="166991-1-1-1">Footnotes</heading>
    </fragment></section><section id="166991-content"><fragment id="166991-3"><para>Where application development tools (requirements tools, modelling tools, etc) are employed to capture the functionality, this section document will refer to the availability of that data and indicate the location and name of the tool which is used to capture the data.</para></fragment><fragment id="166991-4"><para>Maximum bugs or defect rate is usually expressed in terms of bugs/KLOC (thousands of lines of code), or bugs per function-point.</para></fragment></section></document>